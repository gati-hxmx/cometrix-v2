#!/bin/bash
# 長い配信（10時間・10万コメント）の保存・集計と、分析画面の API の速さを測る（#47）。
# DATABASE_URL の DB に bench 専用のジョブを作って測り、終わったら消す。結果は表で出す。
#   例: DATABASE_URL=postgres://postgres:t@localhost:54329/t scripts/bench
# bench のジョブは running として作るので、動いているワーカーには拾われない。
# DB のマイグレーションを当てるので、本番の DB には向けない。
set -euo pipefail
cd "$(dirname "$0")/.."
: "${DATABASE_URL:?DATABASE_URL を設定してください}"
exec npx tsx scripts/bench.ts
